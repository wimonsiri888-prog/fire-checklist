# Google Service Account key file path (JSON ที่ดาวน์โหลดจาก Google Cloud Console)
GOOGLE_SERVICE_ACCOUNT_KEY_FILE=service-account.json

# Google Spreadsheet ID (เอาจาก URL ของ Google Sheet)
# เช่น https://docs.google.com/spreadsheets/d/THIS_PART_HERE/edit
GOOGLE_SPREADSHEET_ID=your-spreadsheet-id

# ชื่อ Sheet ใน Google Sheets (แท็บด้านล่าง)
EXTINGUISHER_SHEET_NAME=ExtinguisherLog
CABINET_SHEET_NAME=CabinetLog

# App server port
PORT=3000
